# ── Copy this to .env and fill in values ──────────────────────────────────────

# DeepSeek API key — get from platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# PayMongo keys — get from dashboard.paymongo.com → Developers → API Keys
PAYMONGO_SECRET_KEY=sk_live_your-secret-key-here

# PayMongo Webhook Secret — get from:
# PayMongo Dashboard → Developers → Webhooks → [your webhook] → Secret key
# This is DIFFERENT from your API secret key.
# REQUIRED: without this, all webhook calls will be rejected.
PAYMONGO_WEBHOOK_SECRET=whsk_your-webhook-secret-here

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://pptprov2.vercel.app

# ── Local development only ─────────────────────────────────────────────────────
# Set to "true" to enable /api/generate and /api/generate/both (no payment check)
# NEVER set this on Render — leave it unset or set to "false"
ENABLE_LEGACY_ROUTES=true

# Set to "development" locally to allow localhost CORS
ENVIRONMENT=development
